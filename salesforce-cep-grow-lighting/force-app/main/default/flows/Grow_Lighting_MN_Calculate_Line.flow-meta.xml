        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Proposed_PPE__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fPropPPE</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Baseline_Watts__c</assignToReference>
