            <value><elementReference>fKW</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Customer_kWh_Savings__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fKWH</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Customer_Peak_Coincident_kW__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fPCKW</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Incremental_Cost__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fIncCost</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Technical_TRM_Version__c</assignToReference>
