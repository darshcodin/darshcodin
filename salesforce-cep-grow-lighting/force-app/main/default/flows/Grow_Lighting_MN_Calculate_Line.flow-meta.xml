    <description>Before-save: resolve TRM version by invoice date, compute rebate + initial energy savings (mirrors BRE Expression Set) + 11 dependent DSM metrics + lineage.</description>
    <environments>Default</environments>
    <formulas>
        <name>fRebate</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Fixture_Quantity__c} * {!$Record.Proposed_Fixture_Watts__c} * ROUND(0.70 * (CASE({!$Record.DLC_Tier__c}, "DLC Premium", 1, "DLC Standard", 1, "Non-DLC", 1, 1)), 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fPropPPE</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.Proposed_PPF__c} / {!$Record.Proposed_Fixture_Watts__c}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fBaseW</name>
        <dataType>Number</dataType>
        <expression>ROUND(({!$Record.Proposed_Fixture_Watts__c} * 0.972 * (ROUND({!$Record.Proposed_PPF__c} / {!$Record.Proposed_Fixture_Watts__c}, 2))) / (0.783 * 1.08), 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fKW</name>
        <dataType>Number</dataType>
        <expression>((ROUND(({!$Record.Proposed_Fixture_Watts__c} * 0.972 * (ROUND({!$Record.Proposed_PPF__c} / {!$Record.Proposed_Fixture_Watts__c}, 2))) / (0.783 * 1.08), 0)) - {!$Record.Proposed_Fixture_Watts__c}) / 1000 * 1.33 * {!$Record.Fixture_Quantity__c}</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fKWH</name>
        <dataType>Number</dataType>
        <expression>((ROUND(({!$Record.Proposed_Fixture_Watts__c} * 0.972 * (ROUND({!$Record.Proposed_PPF__c} / {!$Record.Proposed_Fixture_Watts__c}, 2))) / (0.783 * 1.08), 0)) - {!$Record.Proposed_Fixture_Watts__c}) / 1000 * {!$Record.Fixture_Quantity__c} * (CASE({!$Record.Market_Segment_Room_Type__c}, "Cannabis Flower Room", 1.16, "Cannabis Veg Room", 1.24, "Flowering Crops (Tomatoes/Peppers)", 1.21, "Vegetative/Propagation Growth", 1.21, "Microgreens", 1.21, "Clone Room", 1.21, "Combo Veg &amp; Flower Cannabis Room", 1.2, 0)) * (CASE({!$Record.Market_Segment_Room_Type__c}, "Cannabis Flower Room", 4255, "Cannabis Veg Room", 6498, "Flowering Crops (Tomatoes/Peppers)", 4200, "Vegetative/Propagation Growth", 6300, "Microgreens", 6300, "Clone Room", 6300, "Combo Veg &amp; Flower Cannabis Room", 5281, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fPCKW</name>
        <dataType>Number</dataType>
        <expression>ROUND(((ROUND(({!$Record.Proposed_Fixture_Watts__c} * 0.972 * (ROUND({!$Record.Proposed_PPF__c} / {!$Record.Proposed_Fixture_Watts__c}, 2))) / (0.783 * 1.08), 0)) - {!$Record.Proposed_Fixture_Watts__c}) / 1000 * 1.33 * {!$Record.Fixture_Quantity__c}, 3) * (CASE({!$Record.Market_Segment_Room_Type__c}, "Cannabis Flower Room", 0.68, "Cannabis Veg Room", 0.89, "Flowering Crops (Tomatoes/Peppers)", 0.76, "Vegetative/Propagation Growth", 0.95, "Microgreens", 0.95, "Clone Room", 0.95, "Combo Veg &amp; Flower Cannabis Room", 0.78, 0))</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fIncCost</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Fixture_Quantity__c} * {!$Record.Proposed_Fixture_Watts__c} * 1.13</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dSMkWGen</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Customer_Peak_Coincident_kW__c} * {!$Record.TD_Loss_Factor_Used__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>dGrossPCkW</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Customer_Peak_Coincident_kW__c} * {!$Record.Participants_Used__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>dTotalOnlyNetkW</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Customer_Peak_Coincident_kW__c} * {!$Record.Participants_Used__c}) * {!$Record.NTG_Only_Used__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>dTotalNetkW</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Customer_Peak_Coincident_kW__c} * {!$Record.Participants_Used__c}) * {!$Record.NTG_Total_Used__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>dTotalNetPCkWGen</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.Customer_Peak_Coincident_kW__c} * {!$Record.Participants_Used__c}) * {!$Record.NTG_Total_Used__c}) * {!$Record.TD_Loss_Factor_Used__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>dGrosskWh</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Customer_kWh_Savings__c} * {!$Record.Participants_Used__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dProgNetCustkWh</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Customer_kWh_Savings__c} * {!$Record.Participants_Used__c}) * {!$Record.NTG_Total_Used__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dGenkWh</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Customer_kWh_Savings__c} * {!$Record.TD_Loss_Factor_Used__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dProgNetGenkWh</name>
        <dataType>Number</dataType>
        <expression>(({!$Record.Customer_kWh_Savings__c} * {!$Record.Participants_Used__c}) * {!$Record.NTG_Total_Used__c}) * {!$Record.TD_Loss_Factor_Used__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dLifetimeGenkWh</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Customer_kWh_Savings__c} * {!$Record.TD_Loss_Factor_Used__c}) * {!$Record.Measure_Life_Used__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>dLifetimeNetGenkWh</name>
        <dataType>Number</dataType>
        <expression>((({!$Record.Customer_kWh_Savings__c} * {!$Record.Participants_Used__c}) * {!$Record.NTG_Total_Used__c}) * {!$Record.TD_Loss_Factor_Used__c}) * {!$Record.Measure_Life_Used__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Grow Lighting MN - Calculate Line {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Grow Lighting MN - Calculate Line</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Program_Product</name>
        <label>Get Program Product</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_TRM_Group</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.RelatedItemId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ProgramProduct</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>ProductId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_TRM_Group</name>
        <label>Get TRM Group</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_TRM_Version</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>Get_Program_Product.ProductId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UsageImpactGroup</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_TRM_Version</name>
        <label>Get TRM Version (by invoice date)</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Set_Calculation_Outputs</targetReference></connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>StartDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value><elementReference>$Record.Invoice_Date__c</elementReference></value>
        </filters>
        <filters>
            <field>EndDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value><elementReference>$Record.Invoice_Date__c</elementReference></value>
        </filters>
        <filters>
            <field>EndDate</field>
            <operator>IsNull</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UsageImpactGroupVersion</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Version_Label__c</queriedFields>
        <queriedFields>TD_Loss_Factor__c</queriedFields>
        <queriedFields>NTG_Only__c</queriedFields>
        <queriedFields>NTG_Total__c</queriedFields>
        <queriedFields>Measure_Life_Years__c</queriedFields>
        <sortField>Version</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Program_Product</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Fixture_Quantity__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>Market_Segment_Room_Type__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>Proposed_PPF__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>Proposed_Fixture_Watts__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <filters>
            <field>DLC_Tier__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>IndividualApplicationItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>tExplainer</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Grow Lighting MN v2 calculation
Inputs: Qty={!$Record.Fixture_Quantity__c}, Room={!$Record.Market_Segment_Room_Type__c}, PPF={!$Record.Proposed_PPF__c}, Watts={!$Record.Proposed_Fixture_Watts__c}, DLC={!$Record.DLC_Tier__c}, Invoice={!$Record.Invoice_Date__c}
TRM version (by invoice date): {!$Record.Technical_TRM_Version__c} [T&amp;D={!$Record.TD_Loss_Factor_Used__c}, NTG_Only={!$Record.NTG_Only_Used__c}, NTG_Total={!$Record.NTG_Total_Used__c}, Life={!$Record.Measure_Life_Used__c}]
Proposed PPE = ROUND(PPF/Watts,2) = {!$Record.Proposed_PPE__c}
Baseline Watts = ROUND((Watts*0.972*PPE)/(0.783*1.08),0) = {!$Record.Baseline_Watts__c}
Electric Rebate = Qty*Watts*ROUND(0.70*DLC_Adj,2) = {!$Record.Electric_Rebate__c}
kW Demand Savings = {!$Record.Customer_kW_Savings__c}; kWh = {!$Record.Customer_kWh_Savings__c}; Peak Coincident kW = {!$Record.Customer_Peak_Coincident_kW__c}
Incremental Cost = {!$Record.Incremental_Cost__c}
Dependent DSM: SM kW Gen={!$Record.SM_kW_Gen_PCkW__c}, Net kW Cust={!$Record.Total_Net_kW_Customer_PCkW__c}, Gen kWh={!$Record.Gen_kWh__c}, Lifetime Net Gen kWh={!$Record.Lifetime_Net_Gen_kWh__c}</text>
    </textTemplates>
</Flow>
