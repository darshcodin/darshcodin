        <label>Set Calculation Outputs</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <connector>
            <targetReference>Set_Explainer</targetReference>
        </connector>
        <assignmentItems>
            <assignToReference>$Record.Electric_Rebate__c</assignToReference>
