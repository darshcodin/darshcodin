    <description>Reusable CEP line calculator. Resolves the Technical TRM, Program Factors and Incentive Rules versions from the Program Measure rows for the line's Program and Product, hydrates one context payload, runs the savings, incentive and reporting layers chosen by the technical version's patterns, and stores results with full lineage.</description>
    <environments>Default</environments>
    <formulas>
        <name>fEfficacy</name>
        <dataType>Number</dataType>
        <expression>ROUND({!$Record.Proposed_PPF__c} / {!$Record.Proposed_Fixture_Watts__c}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fBaseline</name>
        <dataType>Number</dataType>
        <expression>ROUND(({!$Record.Proposed_Fixture_Watts__c} * {!vTechVer.Prop_Reflector_Eff__c} * {!fEfficacy}) / ({!vTechVer.Base_Reflector_Eff__c} * {!vTechVer.Baseline_Efficacy__c}), 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fDelta</name>
        <dataType>Number</dataType>
        <expression>({!fBaseline} - {!$Record.Proposed_Fixture_Watts__c}) / 1000</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>fHours</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.Market_Segment_Room_Type__c}, "Cannabis Flower Room", 4255, "Cannabis Veg Room", 6498, "Flowering Crops (Tomatoes/Peppers)", 4200, "Vegetative/Propagation Growth", 6300, "Microgreens", 6300, "Clone Room", 6300, "Combo Veg &amp; Flower Cannabis Room", 5281, 0)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fKWhFactor</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.Market_Segment_Room_Type__c}, "Cannabis Flower Room", 1.16, "Cannabis Veg Room", 1.24, "Flowering Crops (Tomatoes/Peppers)", 1.21, "Vegetative/Propagation Growth", 1.21, "Microgreens", 1.21, "Clone Room", 1.21, "Combo Veg &amp; Flower Cannabis Room", 1.2, 0)</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fCF</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.Market_Segment_Room_Type__c}, "Cannabis Flower Room", 0.68, "Cannabis Veg Room", 0.89, "Flowering Crops (Tomatoes/Peppers)", 0.76, "Vegetative/Propagation Growth", 0.95, "Microgreens", 0.95, "Clone Room", 0.95, "Combo Veg &amp; Flower Cannabis Room", 0.78, 0)</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fGrossKW</name>
        <dataType>Number</dataType>
        <expression>{!fDelta} * {!vTechVer.Cooling_Factor__c} * {!$Record.Fixture_Quantity__c}</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fGrossKWh</name>
        <dataType>Number</dataType>
        <expression>{!fDelta} * {!$Record.Fixture_Quantity__c} * {!fKWhFactor} * {!fHours}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fGrossPCkW</name>
        <dataType>Number</dataType>
        <expression>ROUND({!fDelta} * {!vTechVer.Cooling_Factor__c} * {!$Record.Fixture_Quantity__c}, 3) * {!fCF}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fMeasureQty</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Fixture_Quantity__c} * {!$Record.Proposed_Fixture_Watts__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fBaseIncentive</name>
        <dataType>Number</dataType>
        <expression>{!fMeasureQty} * ROUND({!vIRVer.Rebate_Rate_Per_Unit__c} * {!vIRVer.Bonus_Multiplier__c}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fIncentive</name>
        <dataType>Number</dataType>
        <expression>IF(AND(NOT(ISBLANK({!vIRVer.Max_Incentive__c})), {!vIRVer.Max_Incentive__c} &gt; 0, {!fBaseIncentive} &gt; {!vIRVer.Max_Incentive__c}), {!vIRVer.Max_Incentive__c}, {!fBaseIncentive})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fIncCost</name>
        <dataType>Number</dataType>
        <expression>{!fMeasureQty} * {!vIRVer.Inc_Cost_Per_Unit__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fSMkWGen</name>
        <dataType>Number</dataType>
        <expression>{!fGrossPCkW} * {!vPFVer.TD_Loss_Factor__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fGrossPCkWCust</name>
        <dataType>Number</dataType>
        <expression>{!fGrossPCkW} * {!vParticipants}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fTotOnlyNetKW</name>
        <dataType>Number</dataType>
        <expression>({!fGrossPCkW} * {!vParticipants}) * {!vPFVer.NTG_Only__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fTotNetKW</name>
        <dataType>Number</dataType>
        <expression>({!fGrossPCkW} * {!vParticipants}) * {!vPFVer.NTG_Total__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fTotNetPCkWGen</name>
        <dataType>Number</dataType>
        <expression>(({!fGrossPCkW} * {!vParticipants}) * {!vPFVer.NTG_Total__c}) * {!vPFVer.TD_Loss_Factor__c}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>fGrossKWhCust</name>
        <dataType>Number</dataType>
        <expression>{!fGrossKWh} * {!vParticipants}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fProgNetCustKWh</name>
        <dataType>Number</dataType>
        <expression>({!fGrossKWh} * {!vParticipants}) * {!vPFVer.NTG_Total__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fGenKWh</name>
        <dataType>Number</dataType>
        <expression>{!fGrossKWh} * {!vPFVer.TD_Loss_Factor__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fProgNetGenKWh</name>
        <dataType>Number</dataType>
        <expression>(({!fGrossKWh} * {!vParticipants}) * {!vPFVer.NTG_Total__c}) * {!vPFVer.TD_Loss_Factor__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fLifeGenKWh</name>
        <dataType>Number</dataType>
        <expression>({!fGrossKWh} * {!vPFVer.TD_Loss_Factor__c}) * {!vPFVer.Measure_Life_Years__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fLifeNetGenKWh</name>
        <dataType>Number</dataType>
        <expression>((({!fGrossKWh} * {!vParticipants}) * {!vPFVer.NTG_Total__c}) * {!vPFVer.TD_Loss_Factor__c}) * {!vPFVer.Measure_Life_Years__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fContextData</name>
        <dataType>String</dataType>
        <expression>'{"IndividualApplicationItem":[{"id":"' &amp; {!$Record.Id} &amp; '"}]}'</expression>
    </formulas>
