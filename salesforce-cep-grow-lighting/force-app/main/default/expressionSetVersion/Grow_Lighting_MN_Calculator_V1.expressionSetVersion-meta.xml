<?xml version="1.0" encoding="UTF-8"?>
<ExpressionSetDefinitionVersion xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Core calculator: rebate + initial energy savings for LED Grow Fixture MN v2. Lookups inline (Room Type, DLC Tier); constants per TRM reference data.</description>
    <expressionSetDefinition>Grow_Lighting_MN_Calculator</expressionSetDefinition>
    <label>Grow Lighting MN Calculator V1</label>
    <processType>Bre</processType>
    <rank>1</rank>
    <shouldShowExplExternally>false</shouldShowExplExternally>
    <startDate>2026-01-01T00:00:00.000Z</startDate>
    <status>Active</status>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Hours</assignedParameter>
            <expression>IF(Room_Type == "Cannabis Flower Room", 4255, IF(Room_Type == "Cannabis Veg Room", 6498, IF(Room_Type == "Flowering Crops (Tomatoes/Peppers)", 4200, IF(Room_Type == "Vegetative/Propagation Growth", 6300, IF(Room_Type == "Microgreens", 6300, IF(Room_Type == "Clone Room", 6300, IF(Room_Type == "Combo Veg &amp; Flower Cannabis Room", 5281, 0)))))))</expression>
        </assignment>
        <label>Lookup Annual Operating Hours</label>
        <name>LookupHours</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>1</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>kWh_Factor</assignedParameter>
            <expression>IF(Room_Type == "Cannabis Flower Room", 1.16, IF(Room_Type == "Cannabis Veg Room", 1.24, IF(Room_Type == "Flowering Crops (Tomatoes/Peppers)", 1.21, IF(Room_Type == "Vegetative/Propagation Growth", 1.21, IF(Room_Type == "Microgreens", 1.21, IF(Room_Type == "Clone Room", 1.21, IF(Room_Type == "Combo Veg &amp; Flower Cannabis Room", 1.2, 0)))))))</expression>
        </assignment>
        <label>Lookup kWh Savings Factor</label>
        <name>LookupKwhFactor</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>2</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>CF</assignedParameter>
            <expression>IF(Room_Type == "Cannabis Flower Room", 0.68, IF(Room_Type == "Cannabis Veg Room", 0.89, IF(Room_Type == "Flowering Crops (Tomatoes/Peppers)", 0.76, IF(Room_Type == "Vegetative/Propagation Growth", 0.95, IF(Room_Type == "Microgreens", 0.95, IF(Room_Type == "Clone Room", 0.95, IF(Room_Type == "Combo Veg &amp; Flower Cannabis Room", 0.78, 0)))))))</expression>
        </assignment>
        <label>Lookup Coincidence Factor</label>
        <name>LookupCF</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>3</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>DLC_Adj</assignedParameter>
            <expression>IF(DLC_Tier == "DLC Premium", 1.0, IF(DLC_Tier == "DLC Standard", 1.0, IF(DLC_Tier == "Non-DLC", 1.0, 1.0)))</expression>
        </assignment>
        <label>Lookup DLC Adjustment Factor</label>
        <name>LookupDlcAdj</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>4</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>electricRebate</assignedParameter>
            <expression>Qty * Prop_Watts * ROUND(0.70 * DLC_Adj, 2)</expression>
        </assignment>
        <label>Calculate Electric Rebate</label>
        <name>CalcElectricRebate</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>5</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Prop_PPE</assignedParameter>
            <expression>ROUND(PPF / Prop_Watts, 2)</expression>
        </assignment>
        <label>Calculate Proposed PPE</label>
        <name>CalcProposedPPE</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>6</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Base_W</assignedParameter>
            <expression>ROUND((Prop_Watts * 0.972 * Prop_PPE) / (0.783 * 1.08), 0)</expression>
        </assignment>
        <label>Calculate Baseline Watts (derived)</label>
        <name>CalcBaselineWatts</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>7</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>customerKW</assignedParameter>
            <expression>(Base_W - Prop_Watts) / 1000 * 1.33 * Qty</expression>
        </assignment>
        <label>Calculate Customer kW Demand Savings</label>
        <name>CalcCustomerKW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>8</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>customerKWH</assignedParameter>
            <expression>(Base_W - Prop_Watts) / 1000 * Qty * kWh_Factor * Hours</expression>
        </assignment>
        <label>Calculate Customer kWh Energy Savings</label>
        <name>CalcCustomerKWH</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>9</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>customerPCKW</assignedParameter>
            <expression>ROUND(customerKW, 3) * CF</expression>
        </assignment>
        <label>Calculate Customer Peak Coincident kW</label>
        <name>CalcCustomerPCKW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>10</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>incrementalCost</assignedParameter>
            <expression>Qty * Prop_Watts * 1.13</expression>
        </assignment>
        <label>Calculate Incremental Cost</label>
        <name>CalcIncrementalCost</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>11</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
