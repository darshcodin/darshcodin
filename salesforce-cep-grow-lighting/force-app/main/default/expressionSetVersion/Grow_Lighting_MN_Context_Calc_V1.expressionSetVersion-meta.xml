<?xml version="1.0" encoding="UTF-8"?>
<ExpressionSetDefinitionVersion xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Context-hydrated calc: rebate + initial energy savings for LED Grow Fixture MN v2.</description>
    <expressionSetDefinition>Grow_Lighting_MN_Context_Calc</expressionSetDefinition>
    <label>Grow Lighting MN Context Calc V1</label>
    <processType>Bre</processType>
    <rank>1</rank>
    <shouldShowExplExternally>false</shouldShowExplExternally>
    <startDate>2026-01-01T00:00:00.000Z</startDate>
    <status>Active</status>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>electricRebate</assignedParameter>
            <expression>FixtureQuantity * ProposedWatts * ROUND(0.70 * (CASE(DLCTier, "DLC Premium", 1, "DLC Standard", 1, "Non-DLC", 1, 1)), 2)</expression>
        </assignment>
        <label>CalcRebate</label>
        <name>CalcRebate</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>1</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Prop_PPE</assignedParameter>
            <expression>ROUND(ProposedPPF / ProposedWatts, 2)</expression>
        </assignment>
        <label>CalcPPE</label>
        <name>CalcPPE</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>2</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Base_W</assignedParameter>
            <expression>ROUND((ProposedWatts * 0.972 * (ROUND(ProposedPPF / ProposedWatts, 2))) / (0.783 * 1.08), 0)</expression>
        </assignment>
        <label>CalcBaseW</label>
        <name>CalcBaseW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>3</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>customerKW</assignedParameter>
            <expression>((ROUND((ProposedWatts * 0.972 * (ROUND(ProposedPPF / ProposedWatts, 2))) / (0.783 * 1.08), 0)) - ProposedWatts) / 1000 * 1.33 * FixtureQuantity</expression>
        </assignment>
        <label>CalcKW</label>
        <name>CalcKW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>4</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>customerKWH</assignedParameter>
            <expression>((ROUND((ProposedWatts * 0.972 * (ROUND(ProposedPPF / ProposedWatts, 2))) / (0.783 * 1.08), 0)) - ProposedWatts) / 1000 * FixtureQuantity * (CASE(RoomType, "Cannabis Flower Room", 1.16, "Cannabis Veg Room", 1.24, "Flowering Crops (Tomatoes/Peppers)", 1.21, "Vegetative/Propagation Growth", 1.21, "Microgreens", 1.21, "Clone Room", 1.21, "Combo Veg &amp; Flower Cannabis Room", 1.2, 0)) * (CASE(RoomType, "Cannabis Flower Room", 4255, "Cannabis Veg Room", 6498, "Flowering Crops (Tomatoes/Peppers)", 4200, "Vegetative/Propagation Growth", 6300, "Microgreens", 6300, "Clone Room", 6300, "Combo Veg &amp; Flower Cannabis Room", 5281, 0))</expression>
        </assignment>
        <label>CalcKWH</label>
        <name>CalcKWH</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>5</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>customerPCKW</assignedParameter>
            <expression>ROUND(((ROUND((ProposedWatts * 0.972 * (ROUND(ProposedPPF / ProposedWatts, 2))) / (0.783 * 1.08), 0)) - ProposedWatts) / 1000 * 1.33 * FixtureQuantity, 3) * (CASE(RoomType, "Cannabis Flower Room", 0.68, "Cannabis Veg Room", 0.89, "Flowering Crops (Tomatoes/Peppers)", 0.76, "Vegetative/Propagation Growth", 0.95, "Microgreens", 0.95, "Clone Room", 0.95, "Combo Veg &amp; Flower Cannabis Room", 0.78, 0))</expression>
        </assignment>
        <label>CalcPCKW</label>
        <name>CalcPCKW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>6</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>incrementalCost</assignedParameter>
            <expression>FixtureQuantity * ProposedWatts * 1.13</expression>
        </assignment>
        <label>CalcIncCost</label>
        <name>CalcIncCost</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>7</sequenceNumber>
        <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
