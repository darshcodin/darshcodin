<ExpressionSetDefinitionVersion xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Savings pattern: derives a baseline input from the proposed unit's output efficacy, then takes the difference. Serves any measure whose savings come from an efficacy improvement. Emits the standard gross output contract.</description>
    <expressionSetDefinition>P2_EffDelta</expressionSetDefinition>
    <label>P2 Efficiency Delta Savings V1</label>
    <processType>Bre</processType>
    <rank>1</rank>
    <shouldShowExplExternally>false</shouldShowExplExternally>
    <startDate>2026-01-01T00:00:00.000Z</startDate>
    <status>Active</status>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Proposed_Efficacy</assignedParameter>
            <expression>ROUND(ProposedOutput / ProposedInput, 2)</expression>
        </assignment>
        <label>CalcEfficacy</label>
        <name>CalcEfficacy</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>1</sequenceNumber>
        <shouldExposExecPathMsgOnly>false</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Baseline_Input</assignedParameter>
            <expression>ROUND((ProposedInput * PropReflectorEff * (ROUND(ProposedOutput / ProposedInput, 2))) / (BaseReflectorEff * BaselineEfficacy), 0)</expression>
        </assignment>
        <label>CalcBaseline</label>
        <name>CalcBaseline</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>2</sequenceNumber>
        <shouldExposExecPathMsgOnly>false</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Gross_kW</assignedParameter>
            <expression>((ROUND((ProposedInput * PropReflectorEff * (ROUND(ProposedOutput / ProposedInput, 2))) / (BaseReflectorEff * BaselineEfficacy), 0)) - ProposedInput) / 1000 * CoolingFactor * Quantity</expression>
        </assignment>
        <label>CalcGrossKW</label>
        <name>CalcGrossKW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>3</sequenceNumber>
        <shouldExposExecPathMsgOnly>false</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Gross_kWh</assignedParameter>
            <expression>((ROUND((ProposedInput * PropReflectorEff * (ROUND(ProposedOutput / ProposedInput, 2))) / (BaseReflectorEff * BaselineEfficacy), 0)) - ProposedInput) / 1000 * Quantity * (CASE(SegmentCode, "Cannabis Flower Room", 1.16, "Cannabis Veg Room", 1.24, "Flowering Crops (Tomatoes/Peppers)", 1.21, "Vegetative/Propagation Growth", 1.21, "Microgreens", 1.21, "Clone Room", 1.21, "Combo Veg &amp; Flower Cannabis Room", 1.2, 0)) * (CASE(SegmentCode, "Cannabis Flower Room", 4255, "Cannabis Veg Room", 6498, "Flowering Crops (Tomatoes/Peppers)", 4200, "Vegetative/Propagation Growth", 6300, "Microgreens", 6300, "Clone Room", 6300, "Combo Veg &amp; Flower Cannabis Room", 5281, 0))</expression>
        </assignment>
        <label>CalcGrossKWH</label>
        <name>CalcGrossKWH</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>4</sequenceNumber>
        <shouldExposExecPathMsgOnly>false</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
    <steps>
        <actionType>AssignParameterValues</actionType>
        <assignment>
            <assignedParameter>Gross_PCkW</assignedParameter>
            <expression>ROUND(((ROUND((ProposedInput * PropReflectorEff * (ROUND(ProposedOutput / ProposedInput, 2))) / (BaseReflectorEff * BaselineEfficacy), 0)) - ProposedInput) / 1000 * CoolingFactor * Quantity, 3) * (CASE(SegmentCode, "Cannabis Flower Room", 0.68, "Cannabis Veg Room", 0.89, "Flowering Crops (Tomatoes/Peppers)", 0.76, "Vegetative/Propagation Growth", 0.95, "Microgreens", 0.95, "Clone Room", 0.95, "Combo Veg &amp; Flower Cannabis Room", 0.78, 0))</expression>
        </assignment>
        <label>CalcGrossPCkW</label>
        <name>CalcGrossPCkW</name>
        <resultIncluded>true</resultIncluded>
        <sequenceNumber>5</sequenceNumber>
        <shouldExposExecPathMsgOnly>false</shouldExposExecPathMsgOnly>
        <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <stepType>BusinessKnowledgeModel</stepType>
    </steps>
