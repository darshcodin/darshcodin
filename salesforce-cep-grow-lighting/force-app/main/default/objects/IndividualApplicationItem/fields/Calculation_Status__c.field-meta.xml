    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>Not Calculated</fullName><default>true</default><label>Not Calculated</label></value>
            <value><fullName>Requested</fullName><default>false</default><label>Requested</label></value>
            <value><fullName>Calculated</fullName><default>false</default><label>Calculated</label></value>
            <value><fullName>Failed</fullName><default>false</default><label>Failed</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
